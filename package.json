{
  "name": "tern-bridge-droid",
  "version": "0.1.1",
  "private": true,
  "description": "Factory Droid in Tern with original omp UI components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justdoswift/tern-bridge-droid.git"
  },
  "homepage": "https://github.com/justdoswift/tern-bridge-droid#readme",
